# Servnexa web — environment
#
# Copy to .env.local and fill in. Everything below is optional: the site
# runs and stays honest with all of it unset (analytics no-ops, search
# console verification meta simply isn't rendered).

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Unset in dev — no analytics script
# loads and every trackEvent() call in src/lib/analytics.ts is a silent no-op.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console / Bing Webmaster Tools site-verification tokens.
# Get these from the respective consoles after adding the property — do not
# invent a value here.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
