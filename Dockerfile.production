# Multi-stage production build for Servnexa Web (Next.js Standalone)
FROM node:22-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@11.2.2

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/ packages/
COPY apps/web/ apps/web/

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter "@servnexa/brand" build
RUN pnpm --filter "@servnexa/config" build
RUN pnpm --filter "@servnexa/types" build
RUN pnpm --filter "@servnexa/validation" build
RUN pnpm --filter "@servnexa/ui" build
RUN pnpm --filter "@servnexa/web" build

# Runtime container
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup -S -g 1001 servnexa && adduser -S -u 1001 -G servnexa servnexa

COPY --from=builder /app/apps/web/public ./public
COPY --from=builder --chown=servnexa:servnexa /app/apps/web/.next/standalone ./
COPY --from=builder --chown=servnexa:servnexa /app/apps/web/.next/static ./apps/web/.next/static

USER servnexa

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
